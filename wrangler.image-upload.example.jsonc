{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanjamall-image-upload",
  "main": "cloudflare/image-upload-worker.ts",
  "compatibility_date": "2026-07-07",
  "r2_buckets": [
    {
      "binding": "PRODUCT_IMAGES",
      "bucket_name": "tanjamall-product-images"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://YOUR_PROJECT_REF.supabase.co",
    "SUPABASE_ANON_KEY": "YOUR_SUPABASE_ANON_KEY",
    "R2_PUBLIC_BASE_URL": "https://images.tanjamall.com",
    "ALLOWED_ORIGINS": "http://localhost:3000,https://tanjamall.com"
  }
}
